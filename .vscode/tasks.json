{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++: cl.exe build active file",
      "type": "shell",
      "command": "cl.exe",
      "args": [
        "/EHsc",
        "${file}",
        "/Fe:${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$msCompile"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Build the active C/C++ file using cl.exe (MSVC)."
    }
  ]
}
